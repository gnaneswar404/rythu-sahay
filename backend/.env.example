# Values here are development-safe defaults. Never commit a populated .env.
DATABASE_URL=sqlite:///./rythu_sahaya.db
# Optional Supabase Postgres connection string (takes precedence over DATABASE_URL).
SUPABASE_DATABASE_URL=
SECRET_KEY=replace-this-with-a-long-random-value
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
MOCK_VOICE_ENABLED=true
MOCK_TELEPHONY_ENABLED=true
SARVAM_API_KEY=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
